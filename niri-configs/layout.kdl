// layout.kdl

layout {
    gaps 8

    struts {
        left 0
        right 0
        top 0
        bottom 0
    }

    focus-ring {
        off
    }

    border {
        width 1
        active-color "#068a0d"
        inactive-color "#ffffffff"
    }

    shadow {
        on
        softness 2
        spread 0
        color "#1a1a1aee"
    }

    background-color "transparent"


    default-column-width { proportion 0.5; }

       insert-hint {
           color "#ffc87f40"
       }
}

layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}

// Global blur for every window. background-effect only shows through
// transparent/semi-transparent regions, so it's paired with opacity < 1.0
// here to actually be visible. Drop the opacity line if you'd rather blur
// stay invisible except on windows that set their own transparency
// (like your librewolf/ghostty rules).
